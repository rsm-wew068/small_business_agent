{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "PYTHON_VERSION": "3.11"
    }
  },
  "routes": [
    { "src": "/api/admin/appointments", "dest": "/api/admin-appointments" },
    { "src": "/api/admin/inquiries", "dest": "/api/admin-inquiries" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
