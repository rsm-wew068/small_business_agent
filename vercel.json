{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "PYTHON_VERSION": "3.12"
    }
  },
  "rewrites": [
    { "source": "/api/admin/appointments", "destination": "/api/admin-appointments" },
    { "source": "/api/admin/inquiries", "destination": "/api/admin-inquiries" },
    { "source": "/api/admin/analytics", "destination": "/api/admin-analytics" }
  ]
}
